{
  "schema_version": "controller-qlora-pilot-v0.1",
  "component": "controller",
  "base_model": "/workspace/models/Qwen3.5-27B",
  "model_class": "image_text_to_text",
  "quantization": "bnb-nf4-double-quant",
  "compute_dtype": "bfloat16",
  "max_length": 8192,
  "max_steps": 60,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "optimizer": "paged_adamw_8bit",
  "gradient_checkpointing": true,
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj",
      "in_proj_qkv",
      "in_proj_z",
      "out_proj"
    ]
  },
  "notes": [
    "Time-bounded schema pilot, not the final SFT configuration.",
    "Only reviewed Controller records are legal input.",
    "The explicit target list avoids adapting the vision tower for a text-only Controller policy."
  ]
}
