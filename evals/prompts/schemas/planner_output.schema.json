{
  "$defs": {
    "CoverageOperator": {
      "enum": [
        "count",
        "collect_all",
        "top_k",
        "argmax",
        "argmin",
        "complement"
      ],
      "title": "CoverageOperator",
      "type": "string"
    },
    "CoverageRequirement": {
      "additionalProperties": false,
      "description": "Static Planner output; it never contains runtime counts or page IDs.",
      "properties": {
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "operator": {
          "$ref": "#/$defs/CoverageOperator"
        },
        "scope_text": {
          "minLength": 1,
          "title": "Scope Text",
          "type": "string"
        },
        "item_type": {
          "minLength": 1,
          "title": "Item Type",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/CoverageSourceType"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "required": [
        "operator",
        "scope_text",
        "item_type",
        "source_type"
      ],
      "title": "CoverageRequirement",
      "type": "object"
    },
    "CoverageSourceType": {
      "enum": [
        "page",
        "table",
        "figure",
        "chart",
        "visual",
        "element"
      ],
      "title": "CoverageSourceType",
      "type": "string"
    },
    "PlannedSubQuestion": {
      "additionalProperties": false,
      "description": "One independently checkable information need in the initial plan.",
      "properties": {
        "subquestion_id": {
          "minLength": 1,
          "title": "Subquestion Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "coverage_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "subquestion_id",
        "text"
      ],
      "title": "PlannedSubQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict model-facing output before runtime trace is attached.\n\nAn empty ``subquestions`` list is a valid plan without decomposition: the\noriginal question itself becomes the first reading target.  The field remains\nrequired so a missing plan is not confused with an intentional empty plan.",
  "properties": {
    "original_question": {
      "minLength": 1,
      "title": "Original Question",
      "type": "string"
    },
    "subquestions": {
      "items": {
        "$ref": "#/$defs/PlannedSubQuestion"
      },
      "title": "Subquestions",
      "type": "array"
    },
    "coverage_requirement": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageRequirement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "original_question",
    "subquestions"
  ],
  "title": "PlannerDraft",
  "type": "object"
}
